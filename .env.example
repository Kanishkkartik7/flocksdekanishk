# Copy to .env and fill in. .env is git-ignored.
PORTAL_URL=https://urja-ops.flockenergy.tech
PORTAL_USERNAME=operator@urja.local
PORTAL_PASSWORD=change-me

# Optional tuning (defaults shown)
# PORTAL_TIMEOUT_SECONDS=15
# PORTAL_MAX_ATTEMPTS=3
