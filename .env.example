# PORTAL_MAX_CONCURRENCY=4
# PORTAL_SESSION_MAX_AGE_SECONDS=3300
# METADATA_TTL_SECONDS=900
# READINGS_TTL_SECONDS=300
# REFRESH_RETRY_SECONDS=30
# WARM_CACHE_ON_STARTUP=true
