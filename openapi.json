    "/network": {
      "get": {
        "tags": [
          "network"
        ],
        "summary": "Network hierarchy tree",
        "description": "Zone → circle → division → subdivision → substation → feeder → transformer, with meter counts, rebuilt from each\nmeter's reported path. The portal's hierarchy data is inconsistent, so nodes are keyed by their full path (a code\ncan appear under more than one parent) and every inconsistency found is listed in `issues`.",
        "operationId": "get_network_network_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NetworkResponse"
                }
              }
            }
