          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Readings from this time (inclusive). ISO-8601. Without an offset, the time is taken as IST (+05:30).",
              "title": "Start"
            },
            "description": "Readings from this time (inclusive). ISO-8601. Without an offset, the time is taken as IST (+05:30)."
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Readings up to this time (inclusive). ISO-8601. Without an offset, the time is taken as IST (+05:30).",
              "title": "End"
            },
            "description": "Readings up to this time (inclusive). ISO-8601. Without an offset, the time is taken as IST (+05:30)."
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "30m",
                "1d"
              ],
              "type": "string",
              "description": "`30m` intervals or `1d` (IST calendar days).",
              "default": "30m",
