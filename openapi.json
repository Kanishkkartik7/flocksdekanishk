  "components": {
    "schemas": {
      "ConsumptionInterval": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "energy_kwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Energy Kwh",
            "description": "Active energy used in the interval. `null` if it can't be derived."
          },
          "apparent_energy_kvah": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Apparent Energy Kvah",
            "description": "Apparent energy in the interval."
          },
          "power_factor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Power Factor",
            "description": "`energy_kwh / apparent_energy_kvah`, rounded to 3 decimals."
          },
          "interval_count": {
            "type": "integer",
            "title": "Interval Count",
            "description": "Number of 30-minute intervals summed into this row (1 for `30m`)."
          },
          "flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flags",
            "description": "Data-quality flags: `gap` (readings not 30 min apart), `missing_value`, `negative_delta` (register went down), `power_factor_above_1`, `partial_day` (daily rows with fewer than 48 intervals)."
          }
        },
        "type": "object",
        "required": [
          "start",
          "end",
          "energy_kwh",
          "apparent_energy_kvah",
          "power_factor",
          "interval_count",
          "flags"
        ],
        "title": "ConsumptionInterval"
      },
      "ConsumptionResponse": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id"
          },
          "interval": {
            "type": "string",
            "enum": [
              "30m",
              "1d"
            ],
            "title": "Interval"
          },
          "total_energy_kwh": {
            "type": "number",
            "title": "Total Energy Kwh",
            "description": "Sum of `energy_kwh` over all rows (nulls skipped)."
          },
          "intervals": {
            "items": {
              "$ref": "#/components/schemas/ConsumptionInterval"
            },
            "type": "array",
            "title": "Intervals"
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "interval",
          "total_energy_kwh",
          "intervals"
        ],
        "title": "ConsumptionResponse"
      },
      "DataIssue": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind",
            "description": "`blank_code`, `blank_name`, `conflicting_names`, `multiple_parents`, `feeder_mismatch` or `unknown_transformer`.",
            "examples": [
              "conflicting_names"
            ]
          },
          "level": {
            "type": "string",
            "title": "Level",
            "examples": [
              "dt"
            ]
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code",
            "examples": [
              "DT-007"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "meter_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Meter Ids",
            "description": "Affected meters, where it's a short list."
